---
import Seo from '../components/Seo.astro';
// Timeoff — Information. Pared-back editorial page: a short studio statement
// (who we are / what we do / what we want to work on) + contact. StudioSmall-ish,
// no frills. Matches the home system: Host Grotesk, white ground, #101113 ink.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Information — Timeoff</title>
    <Seo title="Information — Timeoff" description="About RJ Rivera and the Timeoff studio — background, approach, and how to get in touch." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Cross-page swipe direction. Axis: Work(0) · Home(1) · Information(2).
      (function () {
        // Directional swipe is a desktop mechanic. On mobile we let the browser's
        // default view-transition cross-fade play instead (smooth, no slide).
        var mobile = window.matchMedia('(max-width: 768px)').matches;
        function axis(p) {
          if (p === '/' || p === '') return 1;
          if (p.indexOf('/work') === 0) return 0;
          if (p.indexOf('/information') === 0) return 2;
          return null;
        }
        function dirType(fromUrl, toUrl) {
          var f = axis(new URL(fromUrl).pathname), t = axis(new URL(toUrl).pathname);
          if (f == null || t == null || f === t) return null;
          return t > f ? 'to-right' : 'to-left';
        }
        window.addEventListener('pageswap', function (e) {
          if (mobile) { sessionStorage.removeItem('swipeDir'); return; }
          if (!e.viewTransition || !e.activation || !e.activation.from) { sessionStorage.removeItem('swipeDir'); return; }
          var type = dirType(e.activation.from.url, e.activation.entry.url);
          if (!type) { sessionStorage.removeItem('swipeDir'); return; }
          sessionStorage.setItem('swipeDir', type);
          e.viewTransition.types.add(type);
        });
        window.addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return;
          if (mobile) { sessionStorage.removeItem('swipeDir'); return; }
          var type = sessionStorage.getItem('swipeDir');
          sessionStorage.removeItem('swipeDir');
          if (!type) {
            var a = window.navigation && navigation.activation;
            if (a && a.from) type = dirType(a.from.url, a.entry.url);
          }
          if (type) e.viewTransition.types.add(type);
        });
      })();
    </script>
    <style>
      :root {
        --ground: #ffffff;
        --ink: #101113;
        --muted: #8b8b86;
        --font: "Host Grotesk", system-ui, -apple-system, sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--font);
        -webkit-font-smoothing: antialiased;
      }

      /* ——— top bar: Projects · timeoff · Information ——— */
      .top-link {
        position: fixed;
        top: 1.1rem;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        z-index: 2;
      }
      .brand { left: 50%; transform: translateX(-50%); }
      .top-left { left: 1.5rem; }
      .top-right { right: 1.5rem; color: var(--muted); }
      a.top-left { transition: opacity 0.2s ease; }
      a.top-left:hover { opacity: 0.55; }

      /* ——— body ——— */
      .info {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30vh 1.5rem 5rem;
        display: grid;
        grid-template-columns: minmax(0, 40rem) minmax(0, 15rem);
        justify-content: space-between;
        gap: 4rem 6rem;
      }

      .statement p {
        margin: 0 0 1.15em;
        font-size: 1.02rem;
        line-height: 1.5;
        letter-spacing: -0.005em;
        max-width: 38rem;
      }
      .statement p:last-child { margin-bottom: 0; }
      .statement .line { display: block; }
      .statement .line + .line { margin-top: 0.5em; }
      .statement .closer { margin-top: 1.15em; }

      .contact { font-size: 1.02rem; line-height: 1.5; }
      .contact .row { margin-bottom: 1.4rem; }
      .contact .row:last-child { margin-bottom: 0; }
      .contact .k { color: var(--muted); margin: 0 0 0.15rem; }
      .contact a { display: block; color: var(--ink); text-decoration: none; }
      .contact a + a { margin-top: 0.15rem; }
      .contact a:hover { text-decoration: underline; text-underline-offset: 0.15em; }

      @media (max-width: 780px) {
        .info {
          grid-template-columns: 1fr;
          padding: 16vh 1.4rem 4rem;
          gap: 2.5rem;
        }
        .statement p { font-size: 1.05rem; }
        .contact { font-size: 1.05rem; }
        .top-right { display: none; }
      }

      /* ——— cross-page swipe (native view transitions) ——— */
      @view-transition { navigation: auto; }
      ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
      @keyframes swipe-out-left  { to   { transform: translateX(-100%); } }
      @keyframes swipe-in-right  { from { transform: translateX(100%);  } }
      @keyframes swipe-out-right { to   { transform: translateX(100%);  } }
      @keyframes swipe-in-left   { from { transform: translateX(-100%); } }
      :root:active-view-transition-type(to-right)::view-transition-old(root) { animation: swipe-out-left 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; }
      :root:active-view-transition-type(to-right)::view-transition-new(root) { animation: swipe-in-right 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; box-shadow: -1px 0 0 rgba(0, 0, 0, 0.14); }
      :root:active-view-transition-type(to-left)::view-transition-old(root)  { animation: swipe-out-right 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; }
      :root:active-view-transition-type(to-left)::view-transition-new(root)  { animation: swipe-in-left 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; box-shadow: 1px 0 0 rgba(0, 0, 0, 0.14); }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root), ::view-transition-new(root) { animation: none !important; }
      }
    </style>
  </head>
  <body>
    <a class="top-link top-left" href="/work">Work</a>
    <a class="top-link brand" href="/">timeoff</a>
    <span class="top-link top-right" aria-current="page">Information</span>

    <main class="info">
      <div class="statement">
        <p>Timeoff is an independent design and product studio led by RJ Rivera — based in New York City. We help ambitious companies stand out through experimental, considered design across brand, product, and the web.</p>
        <p>We're drawn to teams who care about how they show up: founders building something new, companies ready to challenge the expected, and people who believe the details are the difference.</p>
        <p><span class="line">Things we hate: Following Trends. Playing it safe. Lack of empathy.</span><span class="line">Things we love: Taking risks.</span></p>
        <p class="closer">#enjoyyourtimeoff</p>
      </div>

      <div class="contact">
        <div class="row">
          <p class="k">New business</p>
          <a href="mailto:rj@rjstimeoff.com">rj@rjstimeoff.com</a>
        </div>
        <div class="row">
          <p class="k">Elsewhere</p>
          <a href="https://www.instagram.com/timeoffnyc/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.linkedin.com/in/raul-j-rivera/" target="_blank" rel="noopener">LinkedIn</a>
        </div>
        <div class="row">
          <p class="k">Based in</p>
          <span>NYC</span>
        </div>
      </div>
    </main>
  </body>
</html>
