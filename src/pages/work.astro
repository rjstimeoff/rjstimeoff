---
// Timeoff — Work index, editorial. Big type rows on the left (num · title · year);
// a single preview frame on the right crossfades + plays the hovered project's demo.
// Still, then alive: nothing plays until you point at a row. Years are placeholders.
const projects = [
  { href: '/bird-dog',        title: 'Bird Dog',        year: '2025', src: '/bird-dog.mov' },
  { href: '/stripe-redesign', title: 'Stripe Redesign', year: '2026', src: '/stripe-redesign.mov' },
  { href: '/ui-playground',   title: 'UI Playground',   year: '2026', src: '/ui-playground.mov' },
  { href: '/jpl-redesign',    title: 'JPL Redesign',    year: '2026', src: '/jpl-redesign.mp4' },
  { href: '/cove-landing', title: 'Cove Landing', year: '2026', src: '/cove-thumb.mp4' },
  { href: '/cosign', title: 'COSIGN', year: '2026', src: '/cosign-thumb.mp4' },
  { href: '/ish-knits', title: 'Ish Knits', year: '2026', src: '/ish-knits-thumb.mp4' },
  { href: '/berneron', title: 'Berneron', year: '2026', src: '/berneron-thumb.mp4' },
];
// Some pieces (graphic design) preview as a still, not a looping demo.
const isImg = (s) => /\.(png|jpe?g|webp|gif|avif)$/i.test(s);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Work — Timeoff</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Paint the mobile theme from the first frame: stamp <html> before <body> renders,
      // so there's no flash of the desktop (red text / textured bg) on navigation.
      if (window.matchMedia && window.matchMedia('(max-width: 768px)').matches) {
        document.documentElement.classList.add('is-mobile');
      }
    </script>
    <script is:inline>
      // Persisted-label handoff (see /timeoff): force the TL label to its
      // enlarged size before paint when we arrive from a top-left nav click,
      // so the big word feels continuous across the swap (Work→Home, etc).
      if (sessionStorage.getItem('navTL')) {
        document.documentElement.classList.add('pre-tl');
        sessionStorage.removeItem('navTL');
      }
    </script>
  </head>
  <body>
    <main class="work">
      <ol class="index" style={`--n:${projects.length}`}>
        {projects.map((p, i) => (
          <li>
            <a class="row" href={p.href} data-i={i}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="title">{p.title}</span>
              <span class="year">{p.year}</span>
            </a>
          </li>
        ))}
      </ol>

      <aside class="preview" aria-hidden="true">
        {projects.map((p, i) => (
          isImg(p.src)
            ? <img class="frame" data-i={i} src={p.src} alt="" loading="lazy" />
            : <video
                class="frame"
                data-i={i}
                src={p.src}
                muted loop playsinline preload="metadata"
              ></video>
        ))}
      </aside>
    </main>

    {/* Mobile-only: StudioSmall-style two-column grid of auto-looping video thumbnails.
        preload="none" + display:none on desktop keeps these from loading there; the
        poster shows instantly on mobile until each loop starts. */}
    <section class="work-grid" aria-label="projects">
      {projects.map((p, i) => (
        <a class="cell" href={p.href}>
          {isImg(p.src)
            ? <img class="cell-vid" src={p.src} alt={p.title} loading="lazy" />
            : <video
                class="cell-vid"
                src={p.src}
                poster={"/work-" + p.href.slice(1) + ".jpg"}
                muted loop autoplay playsinline preload="none"
              ></video>}
          <span class="cell-cap"><span class="cell-title">{p.title}</span><span class="cell-year">{p.year}</span></span>
        </a>
      ))}
    </section>

    <nav class="chrome" aria-label="site">
      <a class="label tl home grow" href="/">Home</a>
      <a class="label tr info grow" href="/information">Information</a>
    </nav>

    <style>
      :root {
        --bg: #eef0ec;   /* light base — matches the painterly backdrop's near-white */
        --fg: #d6352a;   /* red — nav titles + project labels on the light page */
        --fg-mute: rgba(214, 53, 42, 0.42);  /* resting row ink */
        --rule: rgba(40, 44, 60, 0.12);      /* hairline between rows */
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { height: 100%; }
      html { background: var(--bg); }   /* light base so the fade-in starts neutral, no white flash */
      body {
        min-height: 100vh;
        background: var(--bg) url('/work-bg.png') center / cover no-repeat;
        color: var(--fg);
        font-family: 'Inter', sans-serif;
        overflow: hidden;
      }

      /* ——— two-column editorial: index left, single preview frame right ——— */
      .work {
        position: fixed;
        inset: 0;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        align-items: center;
        gap: 4vw;
        padding: 3rem clamp(2.2rem, 6vw, 7rem);   /* clear the corner chrome */
      }

      /* ——— the index: stacked type rows ——— */
      .index { list-style: none; }
      .index li { border-top: 1px solid var(--rule); }
      .index li:last-child { border-bottom: 1px solid var(--rule); }

      .row {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: baseline;
        gap: 1.4rem;
        text-decoration: none;
        /* row vertical rhythm scales to the count so the whole list fits the viewport */
        padding: clamp(0.3rem, calc(80vh / var(--n, 8) * 0.12), 1.4rem) 0.4rem;
        color: var(--fg-mute);
        transition: color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .num {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        font-variant-numeric: tabular-nums;
        opacity: 0.7;
        transform: translateY(-0.55em);   /* sit it like a superscript marker */
      }
      .title {
        /* title also scales to the count (capped by vw) so more rows never overflow */
        font-size: clamp(1.4rem, min(5.2vw, calc(80vh / var(--n, 8) * 0.66)), 4.6rem);
        font-weight: 500;
        line-height: 0.98;
        letter-spacing: -0.01em;
        white-space: nowrap;
        will-change: transform, font-weight;
        transition:
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          font-weight 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          letter-spacing 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .year {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        font-variant-numeric: tabular-nums;
        opacity: 0;
        transform: translateX(-0.4rem);
        transition: opacity 0.5s ease, transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* hover (or keyboard focus): the row wakes — ink saturates, title leans in
         and thickens, the year fades up on the right. */
      .row:hover, .row:focus-visible { color: var(--fg); outline: none; }
      .row:hover .title, .row:focus-visible .title {
        font-weight: 800;
        letter-spacing: -0.025em;
        transform: translateX(0.6rem);
      }
      .row:hover .year, .row:focus-visible .year { opacity: 0.85; transform: none; }

      /* dim the siblings of the active row so the eye stays with the hovered one */
      .index:hover .row:not(:hover) { color: rgba(214, 53, 42, 0.24); }

      /* ——— the preview frame: stacked videos, crossfaded ——— */
      .preview {
        position: relative;
        justify-self: center;
        width: clamp(280px, 32vw, 460px);
        aspect-ratio: 1 / 1;
        box-shadow: 0 22px 60px rgba(40, 44, 60, 0.2);
        background: #dcdcd4;
      }
      .frame {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .frame.active { opacity: 1; }

      /* ——— corner chrome, mirroring /timeoff but dark ink on the light page ——— */
      .chrome { position: fixed; inset: 0; z-index: 2; pointer-events: none; mix-blend-mode: difference; }
      .label {
        position: fixed;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #fff;
      }
      .grow {
        pointer-events: auto;
        text-decoration: none;
        white-space: nowrap;
        line-height: 1;
        will-change: font-size;
        transition:
          font-size 0.62s cubic-bezier(0.16, 1, 0.3, 1),
          letter-spacing 0.62s cubic-bezier(0.16, 1, 0.3, 1),
          font-weight 0.62s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .grow:hover {
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .home:hover { font-size: clamp(2.4rem, 6vw, 5.6rem); }  /* TL — loudest, matches Work */
      .info:hover { font-size: clamp(1.8rem, 4vw, 3.9rem); }  /* TR — a notch smaller, matches home */

      html.pre-tl .grow { transition: none; }
      html.pre-tl .home {
        font-size: clamp(2.4rem, 6vw, 5.6rem);
        font-weight: 800;
        letter-spacing: -0.02em;
      }

      .tl { top: 1.9rem; left: 2.2rem; }
      .tr { top: 1.9rem; right: 2.2rem; }

      /* ——— Mobile: StudioSmall-style 2-column grid of auto-looping thumbnails ———
         The hover-preview index is desktop-only (dead on touch), so mobile gets its
         own scrollable grid. Hidden ≥769px. */
      .work-grid { display: none; }

      /* First-paint mobile theme (html.is-mobile set by the head script): swap the red
         desktop index for the white grid on the very first frame, before the @media
         rules resolve — removes the desktop flash on navigation. */
      html.is-mobile, html.is-mobile body { background: #fff; }
      html.is-mobile .work { display: none; }
      html.is-mobile .work-grid { display: grid; }

      /* Mobile theme — deliberately plain: the desktop's red-on-light package reads
         busy on a phone. Off-white ground, small near-black caption, flat thumbnails,
         no shadows. StudioSmall-simple. */
      @media (max-width: 768px) {
        /* let the page scroll; the desktop index is fixed/overflow-hidden */
        html, body { height: auto; }
        html { background: #fff; }   /* no flash of the desktop light ground */
        body {
          overflow-x: hidden;
          overflow-y: auto;
          background: #fff;
        }
        .work { display: none; }   /* retire the hover-driven two-column index */

        .work-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 1.6rem 1rem;
          padding: 5rem 1.4rem 3rem;   /* top clears the corner chrome */
        }
        .cell { text-decoration: none; display: block; }
        .cell-vid {
          display: block;
          width: 100%;
          aspect-ratio: 4 / 5;           /* tall portrait crop, like StudioSmall */
          object-fit: cover;
          background: #e8e7e2;           /* flat placeholder; no drop shadow */
        }
        .cell-cap { display: block; margin-top: 0.55rem; }
        .cell-title {
          font-size: 0.85rem;
          font-weight: 500;
          letter-spacing: 0;
          color: #141414;
          line-height: 1.2;
        }
        .cell-year { display: none; }    /* keep it to just the title — simple */

        /* corner chrome: scrolls with the page (absolute), static, and inherits the
           base white + difference blend so it inverts over whatever's behind it. */
        .chrome { position: absolute; }
        .label {
          position: absolute;
          font-size: 0.72rem;
          letter-spacing: 0.16em;
        }
        .grow { will-change: auto; transition: none; }
        .tl { top: 1.6rem; left: 1.4rem; }
        .tr { top: 1.6rem; right: 1.4rem; }
      }
      /* Touch devices have no hover, so the nav enlarge — both the :hover growth and
         the persisted cross-page handoff (pre-tl/pre-tr) — only reads as a broken
         giant word. Keep the nav labels small and static on mobile. */
      @media (hover: none) {
        .grow, .grow:hover, html.pre-tl .grow, html.pre-tr .grow {
          font-size: 0.72rem !important;
          font-weight: 600 !important;
          letter-spacing: 0.16em !important;
        }
      }

    </style>

    <script>
      // still, then alive: the preview rests on the first project's frozen frame.
      // Pointing at a row crossfades the frame to that project and plays its demo;
      // leaving the index settles back to the resting first frame, paused.
      const rows   = Array.from(document.querySelectorAll<HTMLAnchorElement>('.row'));
      const frames = Array.from(document.querySelectorAll<HTMLVideoElement>('.frame'));
      const index  = document.querySelector('.index');

      // Mobile: the hover-preview index is hidden — drop its video srcs so they never
      // fetch — and drive the grid thumbnails, playing each only while it's on screen.
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      if (isMobile) {
        frames.forEach((v) => {
          if (v instanceof HTMLVideoElement) { v.removeAttribute('src'); v.load(); }
        });
        const cells = Array.from(document.querySelectorAll<HTMLVideoElement>('.cell-vid'));
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            const v = e.target;
            if (!(v instanceof HTMLVideoElement)) return;   // still-image cells don't play
            if (e.isIntersecting) { v.play().catch(() => {}); }
            else { v.pause(); }
          });
        }, { rootMargin: '150px' });
        cells.forEach((v) => io.observe(v));
      }

      function show(i: number, play: boolean) {
        frames.forEach((v, j) => {
          const on = j === i;
          v.classList.toggle('active', on);
          if (!(v instanceof HTMLVideoElement)) return;   // still-image previews just crossfade
          if (on && play) { v.play(); }
          else { v.pause(); if (!on) v.currentTime = 0; }
        });
      }

      show(0, false);   // resting state

      const isTouch = window.matchMedia('(hover: none)').matches;
      if (!isTouch) {
        rows.forEach((row, i) => {
          row.addEventListener('mouseenter', () => show(i, true));
          row.addEventListener('focus',      () => show(i, true));
        });
        index?.addEventListener('mouseleave', () => show(0, false));
      }

      // top-left nav: flag the persisted-enlarge handoff, then navigate normally
      document.querySelector('a.home')?.addEventListener('click', () => {
        sessionStorage.setItem('navTL', '1');
      });
      // top-right nav (Information): same handoff for the next page
      document.querySelector('a.info')?.addEventListener('click', () => {
        sessionStorage.setItem('navTR', '1');
      });
      window.addEventListener('pointermove', () => {
        document.documentElement.classList.remove('pre-tl');
        document.documentElement.classList.remove('pre-tr');
      }, { once: true });
    </script>
  </body>
</html>
