---
// Timeoff — Work.
// Right-side gallery (~5/8 width), rows of 3, StudioSmall-style portrait
// thumbnails. Left column (~3/8) reserved for text — built later.
// Thumbnails are placeholders for now; titles are the real projects.
// Ordered newest → oldest (top-left is newest); grid renders in this order.
const projects = [
  { title: 'Berneron', href: '/berneron', tags: ['Graphic Design'], year: '2026', src: '/berneron-thumb.mp4' },
  { title: 'Ish Knits', href: '/ish-knits', tags: ['Graphic Design'], year: '2026', src: '/ish-knits-thumb.mp4' },
  { title: 'Cosign', href: '/cosign', tags: ['Product Design'], year: '2026', src: '/cosign-thumb.mp4' },
  { title: 'Cove', href: '/cove-landing', tags: ['Web Design'], year: '2026', src: '/cove-thumb.mp4' },
  { title: 'JPL Redesign', href: '/jpl-redesign', tags: ['Web Design'], year: '2026', src: '/jpl-redesign.mp4' },
  { title: 'Stripe Redesign', href: '/stripe-redesign', tags: ['Web Design'], year: '2026', src: '/stripe-redesign.mov' },
  { title: 'UI Playground', href: '/ui-playground', tags: ['Product Design'], year: '2026', src: '/ui-playground.mov' },
  { title: 'Bird Dog', href: '/bird-dog', tags: ['Product Design'], year: '2025', src: '/bird-dog.mov' },
];
const filters = ['All', 'Product Design', 'Web Design', 'Graphic Design'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Work — Timeoff</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Cross-page swipe direction. Axis: Work(0) · Home(1) · Information(2).
      (function () {
        function axis(p) {
          if (p === '/' || p === '') return 1;
          if (p.indexOf('/work') === 0) return 0;
          if (p.indexOf('/information') === 0) return 2;
          return null;
        }
        function dirType(fromUrl, toUrl) {
          var f = axis(new URL(fromUrl).pathname), t = axis(new URL(toUrl).pathname);
          if (f == null || t == null || f === t) return null;
          return t > f ? 'to-right' : 'to-left';
        }
        window.addEventListener('pageswap', function (e) {
          if (!e.viewTransition || !e.activation || !e.activation.from) { sessionStorage.removeItem('swipeDir'); return; }
          var type = dirType(e.activation.from.url, e.activation.entry.url);
          if (!type) { sessionStorage.removeItem('swipeDir'); return; }
          sessionStorage.setItem('swipeDir', type);
          e.viewTransition.types.add(type);
        });
        window.addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return;
          var type = sessionStorage.getItem('swipeDir');
          sessionStorage.removeItem('swipeDir');
          if (!type) {
            var a = window.navigation && navigation.activation;
            if (a && a.from) type = dirType(a.from.url, a.entry.url);
          }
          if (type) e.viewTransition.types.add(type);
        });
      })();
    </script>
    <style>
      :root {
        --ground: #ffffff;
        --ink: #101113;
        --ink-soft: #6f6f68;
        --placeholder: #ECEBE7;
        --placeholder-2: #E3E2DC;
        --font: "Host Grotesk", system-ui, -apple-system, sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--font);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      /* persistent brand wordmark — top center, across pages */
      .brand {
        position: fixed;
        top: 1.1rem;
        left: 50%;
        transform: translateX(-50%) translateY(0);
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        z-index: 3;
        transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s ease;
      }
      /* scrolled away from the top: lift up out of the way + fade */
      .brand.tucked {
        transform: translateX(-50%) translateY(-160%);
        opacity: 0;
        pointer-events: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .brand { transition: opacity 0.3s ease; }
        .brand.tucked { transform: translateX(-50%) translateY(0); }
      }

      /* corner nav — Work (left, self) · Information (right, link). Home = brand. */
      .corner {
        position: fixed;
        top: 1.1rem;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        z-index: 3;
        transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s ease;
      }
      .corner-left { left: 1.5rem; }
      .corner-right { right: 1.5rem; }
      .corner.is-self { color: var(--ink-soft); pointer-events: none; }
      a.corner:hover { opacity: 0.55; }
      /* tuck away on scroll, in step with the brand */
      .corner.tucked { transform: translateY(-160%); opacity: 0; pointer-events: none; }
      @media (prefers-reduced-motion: reduce) {
        .corner { transition: opacity 0.3s ease; }
        .corner.tucked { transform: none; }
      }

      /* left text (~3/8) | right gallery (~5/8) */
      .layout {
        display: grid;
        grid-template-columns: 3fr 5fr;
        gap: 2.5rem;
        padding: 5.5rem 1.5rem 5rem;
        max-width: 1600px;
        margin: 0 auto;
      }

      /* left column — reserved for text, sticky so it holds as gallery scrolls */
      .col-text {
        position: sticky;
        top: 5.5rem;
        align-self: start;
        height: max-content;
      }

      /* mock filter nav — aligns with the top of the grid */
      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.1rem;
        font-size: 0.95rem;
        line-height: 1.35;
        max-width: 30ch;
      }
      .filters a {
        color: #a5a49c;
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .filters a:hover { color: var(--ink); }
      .filters a.active { color: var(--ink); }

      /* right gallery */
      .gallery {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        column-gap: 2.75rem;
        row-gap: 3.5rem;
      }
      .item {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        text-decoration: none;
        color: inherit;
      }
      .thumb {
        aspect-ratio: 3 / 4;
        background: var(--placeholder);
        border-radius: 2px;
        overflow: hidden;
      }
      .thumb-vid {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
      }
      .caption {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      .title {
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0.005em;
      }
      .subtitle {
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0.005em;
        color: var(--ink-soft);
      }
      .item { transition: opacity 0.22s ease, transform 0.22s ease; }
      .item.hidden { display: none; }
      .item.leaving { opacity: 0; transform: scale(0.97); }
      .filters a { cursor: pointer; }

      @media (max-width: 900px) {
        .layout { grid-template-columns: 1fr; }
        .col-text { position: static; }
        .gallery { grid-template-columns: repeat(2, 1fr); }
      }

      /* ——— cross-page swipe (native view transitions) ——— */
      @view-transition { navigation: auto; }
      ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
      @keyframes swipe-out-left  { to   { transform: translateX(-100%); } }
      @keyframes swipe-in-right  { from { transform: translateX(100%);  } }
      @keyframes swipe-out-right { to   { transform: translateX(100%);  } }
      @keyframes swipe-in-left   { from { transform: translateX(-100%); } }
      :root:active-view-transition-type(to-right)::view-transition-old(root) { animation: swipe-out-left 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; }
      :root:active-view-transition-type(to-right)::view-transition-new(root) { animation: swipe-in-right 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; box-shadow: -1px 0 0 rgba(0, 0, 0, 0.14); }
      :root:active-view-transition-type(to-left)::view-transition-old(root)  { animation: swipe-out-right 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; }
      :root:active-view-transition-type(to-left)::view-transition-new(root)  { animation: swipe-in-left 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; box-shadow: 1px 0 0 rgba(0, 0, 0, 0.14); }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root), ::view-transition-new(root) { animation: none !important; }
      }
    </style>
  </head>
  <body>
    <span class="corner corner-left is-self" aria-current="page">Work</span>
    <a class="brand" href="/">timeoff</a>
    <a class="corner corner-right" href="/information">Information</a>

    <main class="layout">
      <div class="col-text">
        <nav class="filters">
          {filters.map((f) => (
            <a href="#" class:list={["filter", { active: f === 'All' }]} data-filter={f}>{f}</a>
          ))}
        </nav>
      </div>

      <div class="gallery">
        {projects.map((p) => (
          <a class="item" href={p.href} data-tags={p.tags.join('|')}>
            <div class="thumb">
              <video class="thumb-vid" src={p.src} poster={p.src.replace(/\.(mp4|mov)$/, '.jpg')} muted loop playsinline preload="metadata" aria-hidden="true"></video>
            </div>
            <div class="caption">
              <div class="title">{p.title}</div>
              <div class="subtitle">{p.tags[0]}, {p.year}</div>
            </div>
          </a>
        ))}
      </div>
    </main>

    <script is:inline>
      // Brand wordmark: tuck up + fade once you scroll off the top,
      // return when the top space is clear again.
      (function () {
        var nav = document.querySelectorAll('.brand, .corner');
        if (!nav.length) return;
        var THRESHOLD = 6;    // px from top before it tucks away
        var ticking = false;
        function update() {
          var tuck = window.scrollY > THRESHOLD;
          nav.forEach(function (el) { el.classList.toggle('tucked', tuck); });
          ticking = false;
        }
        window.addEventListener('scroll', function () {
          if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
        }, { passive: true });
        update();
      })();

      // Filter the gallery by category, animated. Outgoing tiles fade out, then
      // the remaining tiles glide to their new spots (FLIP) while incoming tiles
      // fade in. "All" shows everything.
      (function () {
        var links = document.querySelectorAll('.filters .filter');
        var items = Array.prototype.slice.call(document.querySelectorAll('.gallery .item'));
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var busy = false;

        function matches(it, cat) {
          if (cat === 'All') return true;
          return (it.getAttribute('data-tags') || '').split('|').indexOf(cat) !== -1;
        }

        function apply(cat) {
          if (reduce) {
            items.forEach(function (it) { it.classList.toggle('hidden', !matches(it, cat)); });
            return;
          }
          busy = true;
          // 1) fade out the tiles that are leaving
          var leaving = items.filter(function (it) {
            return !it.classList.contains('hidden') && !matches(it, cat);
          });
          leaving.forEach(function (it) { it.classList.add('leaving'); });

          setTimeout(function () {
            // 2) record positions BEFORE the layout change
            var first = new Map();
            items.forEach(function (it) { first.set(it, it.getBoundingClientRect()); });

            // 3) commit the new visibility (reflows the grid)
            items.forEach(function (it) {
              it.classList.remove('leaving');
              it.classList.toggle('hidden', !matches(it, cat));
            });

            // 4) FLIP: invert to old spot, then play to new; fade in newcomers
            items.forEach(function (it) {
              if (it.classList.contains('hidden')) return;
              var f = first.get(it);
              var last = it.getBoundingClientRect();
              var wasHidden = f.width === 0 && f.height === 0;
              it.style.transition = 'none';
              if (wasHidden) {
                it.style.opacity = '0';
                it.style.transform = 'scale(0.97)';
              } else {
                it.style.transform = 'translate(' + (f.left - last.left) + 'px,' + (f.top - last.top) + 'px)';
              }
              it.getBoundingClientRect(); // force reflow so the invert sticks
              it.style.transition = 'transform 0.42s cubic-bezier(0.2,0.7,0.2,1), opacity 0.32s ease';
              it.style.transform = '';
              it.style.opacity = '';
            });
            busy = false;
          }, 170);
        }

        links.forEach(function (link) {
          link.addEventListener('click', function (e) {
            e.preventDefault();
            if (busy || link.classList.contains('active')) return;
            links.forEach(function (l) { l.classList.remove('active'); });
            link.classList.add('active');
            apply(link.getAttribute('data-filter'));
          });
        });
      })();

      // Thumbnail videos: paused first frame by default, play only while hovered.
      (function () {
        document.querySelectorAll('.gallery .item').forEach(function (item) {
          var vid = item.querySelector('.thumb-vid');
          if (!vid) return;
          item.addEventListener('mouseenter', function () {
            var p = vid.play();
            if (p && p.catch) p.catch(function () {});
          });
          item.addEventListener('mouseleave', function () {
            vid.pause();
            vid.currentTime = 0;
          });
        });
      })();
    </script>
  </body>
</html>
