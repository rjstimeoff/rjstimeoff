---
// Timeoff — Work index. Painterly light backdrop + persistent corner chrome
// (Home TL, Information TR) mirroring the homepage system. Grid comes next.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Work — Timeoff</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Persisted-label handoff (see /timeoff): force the TL label to its
      // enlarged size before paint when we arrive from a top-left nav click,
      // so the big word feels continuous across the swap (Work→Home, etc).
      if (sessionStorage.getItem('navTL')) {
        document.documentElement.classList.add('pre-tl');
        sessionStorage.removeItem('navTL');
      }
    </script>
  </head>
  <body>
    <main class="work">
      <section class="grid">
        <a class="card" href="/bird-dog">
          <video class="thumb" src="/bird-dog.mov" muted loop playsinline preload="metadata"></video>
          <span class="label-sm">Bird Dog</span>
        </a>
        <a class="card" href="/stripe-redesign">
          <video class="thumb" src="/stripe-redesign.mov" muted loop playsinline preload="metadata"></video>
          <span class="label-sm">Stripe Redesign</span>
        </a>
        <a class="card" href="/ui-playground">
          <video class="thumb" src="/ui-playground.mov" muted loop playsinline preload="metadata"></video>
          <span class="label-sm">UI Playground</span>
        </a>
        <a class="card" href="/jpl-redesign">
          <video class="thumb" src="/jpl-redesign.mp4" muted loop playsinline preload="metadata"></video>
          <span class="label-sm">JPL Redesign</span>
        </a>
      </section>
    </main>

    <nav class="chrome" aria-label="site">
      <a class="label tl home grow" href="/timeoff">Home</a>
      <a class="label tr info grow" href="#">Information</a>
    </nav>

    <style>
      :root {
        --bg: #eef0ec;   /* light base — matches the painterly backdrop's near-white */
        --fg: #d6352a;   /* red — nav titles + project labels on the light page */
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { height: 100%; }
      html { background: var(--bg); }   /* light base so the fade-in starts neutral, no white flash */
      body {
        min-height: 100vh;
        background: var(--bg) url('/work-bg.png') center / cover no-repeat;
        color: var(--fg);
        font-family: 'Inter', sans-serif;
        overflow: hidden;
      }

      /* ——— the work grid: four square tiles, 2×2, floating on the painting ——— */
      .work {
        position: fixed;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 5.5rem 2rem;   /* keep clear of the corner chrome */
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2.4rem 2.6rem;
      }
      .card {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        text-decoration: none;
      }
      .thumb {
        width: clamp(200px, 23vw, 320px);
        aspect-ratio: 1 / 1;
        object-fit: cover;       /* square crop of the landscape demo */
        display: block;
        background: #dcdcd4;
        /* soft drop so the tile reads as floating over the painting */
        box-shadow: 0 18px 50px rgba(40, 44, 60, 0.18);
      }
      .label-sm {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--fg);
      }

      /* ——— corner chrome, mirroring /timeoff but dark ink on the light page ——— */
      .chrome { position: fixed; inset: 0; z-index: 2; pointer-events: none; }
      .label {
        position: fixed;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--fg);
      }
      /* same grow-on-hover system as the homepage: a tiny tracked micro-label
         unfurls to near-statement scale on a long weighted expo-out. */
      .grow {
        pointer-events: auto;
        text-decoration: none;
        white-space: nowrap;
        line-height: 1;
        will-change: font-size;
        transition:
          font-size 0.62s cubic-bezier(0.16, 1, 0.3, 1),
          letter-spacing 0.62s cubic-bezier(0.16, 1, 0.3, 1),
          font-weight 0.62s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .grow:hover {
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .home:hover { font-size: clamp(2.4rem, 6vw, 5.6rem); }  /* TL — loudest, matches Work */
      .info:hover { font-size: clamp(1.8rem, 4vw, 3.9rem); }  /* TR — a notch smaller, matches home */

      /* forced-enlarged on arrival (set by the is:inline head script), instant
         and untweened so the persisted TL label appears already-big — matches
         .home:hover so the Work→Home handoff is seamless. */
      html.pre-tl .grow { transition: none; }
      html.pre-tl .home {
        font-size: clamp(2.4rem, 6vw, 5.6rem);
        font-weight: 800;
        letter-spacing: -0.02em;
      }

      .tl { top: 1.9rem; left: 2.2rem; }
      .tr { top: 1.9rem; right: 2.2rem; }
    </style>

    <script>
      // still, then alive: tiles sit on their frozen first frame; the one you
      // point at plays its demo, then freezes back. (Touch: just autoplay all.)
      const isTouch = window.matchMedia('(hover: none)').matches;
      document.querySelectorAll('.card').forEach((card) => {
        const v = card.querySelector('video');
        if (!v) return;
        if (isTouch) {
          v.play();
        } else {
          card.addEventListener('mouseenter', () => v.play());
          card.addEventListener('mouseleave', () => { v.pause(); v.currentTime = 0; });
        }
      });

      // top-left nav: flag the persisted-enlarge handoff, then navigate normally
      document.querySelector('a.home')?.addEventListener('click', () => {
        sessionStorage.setItem('navTL', '1');
      });
      // the instant the user actually moves, hand the size back to native :hover
      window.addEventListener('pointermove', () => {
        document.documentElement.classList.remove('pre-tl');
      }, { once: true });
    </script>
  </body>
</html>
