---
// Timeoff — Bird Dog case study. Same stripped system as the other projects (painterly
// /work backdrop kept as-is, NO mat — a plain left-hung column straight on the painting,
// thin red title/subtitle, bare wide media, one beat per screen). Bird Dog's TWIST: it's a
// full multi-screen product, so its centerpiece is an interactive browser mock — click the
// tabs to flip between the five app screens' demos. Marketing/brand assets close it out. Inter.

// Browser-mock tabs: each is a Bird Dog screen with its own Vimeo demo.
const tabs = [
  { label: 'Home',            url: 'bird-dog.app/home',            vimeo: '1183089656' },
  { label: 'Profile',         url: 'bird-dog.app/profile',         vimeo: '1183089722' },
  { label: 'Jobs',            url: 'bird-dog.app/jobs',            vimeo: '1183089680' },
  { label: 'Resume Workshop', url: 'bird-dog.app/resume-workshop', vimeo: '1183089760' },
  { label: 'Tracker',         url: 'bird-dog.app/tracker',         vimeo: '1183089781' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bird Dog — Timeoff</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Paint the mobile theme from the first frame: stamp <html> before <body> renders,
      // so there's no flash of the desktop (red text / textured bg) on navigation.
      if (window.matchMedia && window.matchMedia('(max-width: 768px)').matches) {
        document.documentElement.classList.add('is-mobile');
      }
    </script>
    <script is:inline>
      if (sessionStorage.getItem('navTL')) {
        document.documentElement.classList.add('pre-tl');
        sessionStorage.removeItem('navTL');
      }
    </script>
  </head>
  <body>
    <main class="page">
      <!-- ——— hero ——— -->
      <section class="panel hero-panel">
        <header class="hero">
          <p class="kicker reveal">Tool Design · Product Strategy · Front End · 2025</p>
          <h1 class="title reveal">Bird Dog</h1>
          <p class="subtitle reveal">A Reimagined LinkedIn</p>
          <p class="scroll-hint reveal">Scroll ↓</p>
        </header>
      </section>

      <!-- ——— hero collage ——— -->
      <section class="panel">
        <figure class="media reveal">
          <img src="/bird_dog_collage.png" alt="Bird Dog — a collage of the product" width="1600" height="1000" loading="eager" />
        </figure>
      </section>

      <!-- ——— intro ——— -->
      <section class="panel text-panel">
        <div class="text reveal">
          <p class="lead">Bird Dog is a reimagined version of LinkedIn that focuses on a better user experience, and incorporates useful AI-native tools that users like me actually want.</p>
          <p>I wanted to see if I could take the AI tools I built to help me job hunt, and weave them into a better version of LinkedIn. I started with a basic web app I built for personal use, then built a whole ecosystem around it. It was a cool opportunity to work on a full ecosystem and figure out how to make every little part not only work together, but feel great.</p>
          <p>There are some really awesome additions: the referral system, the integrated role-fit analysis on the jobs page, an overhauled profile page, a thoughtful application tracker, and of course&hellip; the resume workshop (which was the hardest thing to build).</p>
        </div>
      </section>

      <!-- ——— centerpiece: the clickable browser mock ——— -->
      <section class="panel mock-panel">
        <div class="mock reveal">
          <img class="handwritten-note" src="/click_through_tabs.png" alt="click through the tabs" />
          <div class="browser-frame">
            <div class="browser-tab-strip">
              <div class="traffic-lights">
                <span class="tl-dot tl-red"></span>
                <span class="tl-dot tl-yellow"></span>
                <span class="tl-dot tl-green"></span>
              </div>
              <div class="tab-strip-tabs">
                {tabs.map((t, i) => (
                  <button class:list={["tab-btn", { active: i === 0 }]} data-tab={i} data-url={t.url}>{t.label}</button>
                ))}
              </div>
            </div>

            <div class="browser-toolbar">
              <div class="nav-btns">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8l4-4"/></svg>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12l4-4-4-4"/></svg>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8A5 5 0 1 1 8 3a5 5 0 0 1 3.54 1.46M13 3v3h-3"/></svg>
              </div>
              <div class="url-bar">
                <svg class="lock-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M11 7V5a3 3 0 0 0-6 0v2H4v7h8V7h-1zm-4-2a1 1 0 0 1 2 0v2H7V5z"/></svg>
                <span class="url-text" id="url-display">bird-dog.app/home</span>
              </div>
            </div>

            <div class="tab-panels">
              {tabs.map((t, i) => (
                <div class:list={["tab-panel", { active: i === 0 }]} data-panel={i}>
                  <div class="vimeo-wrapper">
                    <iframe loading="lazy" src={`https://player.vimeo.com/video/${t.vimeo}?autopause=0&muted=1&controls=0&loop=1&title=0&byline=0&portrait=0`} frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ——— closing: marketing / brand assets ——— -->
      <section class="panel gallery-panel">
        <div class="gallery-wrap reveal">
          <p class="caption">Some marketing &amp; promo content I made when building the first version(s) of Bird Dog..</p>
          <div class="media-gallery">
            <div class="media-item span-2"><img src="/bird_dog_man_and_dog.png" alt="Man and dog poster" /></div>
            <div class="media-item"><img src="/bird_dog_with_bird.png" alt="Dog with bird poster" /></div>
            <div class="media-item"><img src="/bird_dog_logo.png" alt="Bird Dog logo" /></div>
            <div class="media-item span-2"><video src="/bird_dog_generated_clip.mp4" muted loop playsinline autoplay></video></div>
          </div>
        </div>
      </section>

      <!-- ——— next project ——— -->
      <section class="panel next-panel">
        <a class="next reveal" href="/stripe-redesign">
          <span class="next-kicker">Next</span>
          <span class="next-title">Stripe Redesign</span>
        </a>
      </section>
    </main>

    <nav class="chrome" aria-label="site">
      <a class="label tl work grow" href="/work">Work</a>
      <a class="label tr info grow" href="/information">Information</a>
    </nav>

    <style>
      :root {
        --fg: #d6352a;                       /* red — accent (kicker, title) */
        --ink: #26241f;                      /* warm near-black — body reading ink */
        --muted: rgba(38, 36, 31, 0.5);      /* captions */
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: #eef0ec; scroll-behavior: smooth; }
      body {
        /* painterly backdrop, kept as-is — content sits straight on the painting, no mat */
        background: #eef0ec url('/work-bg.png') center / cover no-repeat fixed;
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      /* ——— the column: one plain centered measure; painting shows in the gutters ——— */
      .page {
        position: relative;
        z-index: 1;
        max-width: min(92vw, 1080px);
        margin: 0 auto;
        animation: page-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) backwards;
        transition: opacity 0.3s ease-out;
      }
      @keyframes page-in {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: none; }
      }
      .page.leaving { opacity: 0; }
      @media (prefers-reduced-motion: reduce) {
        .page { animation: none; }
        .page.leaving { opacity: 1; transition: none; }
      }

      /* ——— one beat per screen, everything hung to the same left edge ——— */
      .panel {
        min-height: 100vh;
        display: grid;
        align-content: center;
        justify-items: start;
        padding: 12vh 0;
      }

      /* ——— hero ——— */
      .hero { text-align: left; }
      .kicker { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg); margin-bottom: 1.4rem; }
      .title { font-size: clamp(2.6rem, 7vw, 5.4rem); font-weight: 400; line-height: 1; letter-spacing: -0.012em; color: var(--fg); }
      .subtitle { font-size: clamp(2.6rem, 7vw, 5.4rem); font-weight: 400; line-height: 1.04; letter-spacing: -0.012em; color: var(--fg); margin-top: 0.2rem; }
      .scroll-hint { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-top: 3.5rem; }

      /* ——— bare media — no frame, no shadow, demos/screengrabs all at 1060px ——— */
      .media { max-width: 1060px; width: 100%; }
      .caption { font-size: 0.82rem; color: var(--muted); letter-spacing: 0.01em; margin-bottom: 0.7rem; }
      .media img { display: block; width: 100%; height: auto; }

      /* ——— text: quiet, left-hung, one calm treatment (ref: Studio Small) ——— */
      .text-panel p {
        max-width: 58ch;
        font-size: clamp(1.02rem, 1.35vw, 1.16rem);
        font-weight: 400;
        line-height: 1.7;
        color: var(--ink);
      }
      .text { max-width: 58ch; }
      .text p { max-width: none; }
      .text p + p { margin-top: 1.4rem; }
      .text .lead { color: #1a1916; }

      /* ——— centerpiece: clickable browser mock (a depicted device — its inner Helvetica
             imitates real browser UI, so it intentionally sits outside the Inter system) ——— */
      .mock { width: 100%; max-width: 1060px; }
      /* the source PNG is a tall image with the handwriting in its vertical middle (~52%) —
         clip to that band (object-fit/position) so it reads large and tucks right above the tabs */
      .handwritten-note { display: block; width: 480px; max-width: 84%; height: 150px; object-fit: cover; object-position: center 52%; margin: 0 0 0.3rem 0.2rem; opacity: 0.85; pointer-events: none; }
      .browser-frame { border-radius: 10px; overflow: hidden; box-shadow: 0 24px 60px rgba(40,44,60,0.28); }
      .browser-tab-strip { display: flex; align-items: flex-end; background: #35363a; padding: 8px 12px 0 12px; }
      .traffic-lights { display: flex; align-items: center; gap: 6px; padding-bottom: 8px; margin-right: 12px; flex-shrink: 0; }
      .tl-dot { width: 12px; height: 12px; border-radius: 50%; }
      .tl-red { background: #ff5f57; }
      .tl-yellow { background: #febc2e; }
      .tl-green { background: #28c840; }
      .tab-strip-tabs { display: flex; align-items: flex-end; overflow-x: auto; }
      .tab-btn {
        position: relative;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 0.72rem; font-weight: 400; color: #9aa0a6;
        background: #2d2e32; border: none; border-radius: 8px 8px 0 0;
        padding: 6px 16px 7px; margin-right: 2px; cursor: pointer; white-space: nowrap; z-index: 1;
      }
      .tab-btn::before, .tab-btn::after { content: ''; position: absolute; bottom: 0; width: 5px; height: 5px; background: transparent; }
      .tab-btn::before { left: -5px; border-bottom-right-radius: 5px; box-shadow: 3px 0 0 0 #2d2e32; }
      .tab-btn::after { right: -5px; border-bottom-left-radius: 5px; box-shadow: -3px 0 0 0 #2d2e32; }
      .tab-btn:hover { color: #e8eaed; background: #3c3d41; }
      .tab-btn:hover::before { box-shadow: 3px 0 0 0 #3c3d41; }
      .tab-btn:hover::after { box-shadow: -3px 0 0 0 #3c3d41; }
      .tab-btn.active { color: #202124; background: #fff; z-index: 2; }
      .tab-btn.active::before { box-shadow: 3px 0 0 0 #fff; }
      .tab-btn.active::after { box-shadow: -3px 0 0 0 #fff; }
      .browser-toolbar { display: flex; align-items: center; gap: 10px; background: #fff; padding: 6px 12px; border-bottom: 1px solid #e0e0e0; }
      .nav-btns { display: flex; align-items: center; gap: 2px; flex-shrink: 0; }
      .nav-btns svg { width: 18px; height: 18px; color: #9aa0a6; }
      .url-bar { flex: 1; display: flex; align-items: center; gap: 6px; background: #f1f3f4; border-radius: 20px; padding: 4px 12px; }
      .lock-icon { width: 12px; height: 12px; color: #5f6368; flex-shrink: 0; }
      .url-text { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 0.75rem; color: #202124; }
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }
      .vimeo-wrapper { position: relative; width: 100%; aspect-ratio: 3404 / 1836; overflow: hidden; background: #ddd; }
      .vimeo-wrapper iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: none; }

      /* ——— closing media gallery ——— */
      .gallery-wrap { width: 100%; max-width: 1060px; }
      .media-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; margin-top: 0.4rem; }
      .media-item { overflow: hidden; border-radius: 4px; aspect-ratio: 1 / 1; }
      .media-item.span-2 { grid-column: span 2; aspect-ratio: 2 / 1; }
      .media-item img, .media-item video { width: 100%; height: 100%; object-fit: cover; display: block; }

      /* ——— reveal-on-scroll: rises into frame, weighted easing ——— */
      .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }
      .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1 !important; transform: none !important; transition: none; }
      }

      /* ——— next project ——— */
      .next-panel { min-height: 70vh; }
      .next { display: inline-flex; flex-direction: column; gap: 0.4rem; text-decoration: none; }
      .next-kicker { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
      .next-title { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 400; letter-spacing: -0.012em; color: var(--fg); transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
      .next:hover .next-title { transform: translateX(0.6rem); }

      /* ——— corner chrome (matches /work) ——— */
      .chrome { position: fixed; inset: 0; z-index: 4; pointer-events: none; mix-blend-mode: difference; }
      .label { position: fixed; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; }
      .grow { pointer-events: auto; text-decoration: none; white-space: nowrap; line-height: 1; will-change: font-size; transition: font-size 0.62s cubic-bezier(0.16, 1, 0.3, 1), letter-spacing 0.62s cubic-bezier(0.16, 1, 0.3, 1), font-weight 0.62s cubic-bezier(0.16, 1, 0.3, 1); }
      .grow:hover { font-weight: 800; letter-spacing: -0.02em; }
      .work:hover { font-size: clamp(2.4rem, 6vw, 5.6rem); }
      .info:hover { font-size: clamp(1.8rem, 4vw, 3.9rem); }
      html.pre-tl .grow { transition: none; }
      html.pre-tl .work { font-size: clamp(2.4rem, 6vw, 5.6rem); font-weight: 800; letter-spacing: -0.02em; }
      .tl { top: 1.9rem; left: 2.2rem; }
      .tr { top: 1.9rem; right: 2.2rem; }
      /* First-paint mobile theme (html.is-mobile set by the head script): kill the desktop
         red text + textured background on the very first frame, before the @media rules
         resolve — this is what removes the flash on navigation. */
      html.is-mobile { --fg: #141414; }
      html.is-mobile, html.is-mobile body { background: #fff; }

      /* ——— Mobile: white/black StudioSmall retheme + natural stacked scroll
         (shared project-page format; see jpl-redesign). Bird Dog keeps its interactive
         browser-mock — it works on touch (tap the tabs) — just fitted to the phone. ——— */
      @media (max-width: 768px) {
        :root { --fg: #141414; --ink: #1a1a1a; --muted: rgba(20, 20, 20, 0.46); }
        html { background: #fff; }
        body { background: #fff; overflow-x: hidden; }
        .page { max-width: 100%; margin: 0; padding: 0 1rem; }
        .panel { min-height: auto; padding: 4.5vh 0; }
        .hero-panel { min-height: 74vh; padding-top: 20vh; }
        .next-panel { min-height: auto; padding: 6vh 0 12vh; }
        .title, .subtitle { font-size: clamp(2rem, 8.5vw, 2.5rem); }
        .kicker { color: var(--muted); }
        .scroll-hint { margin-top: 2.4rem; }
        .media { max-width: 100%; }

        /* closing marketing gallery: 3 columns → 2 (span-2 items go full-width) */
        .media-gallery { grid-template-columns: 1fr 1fr; gap: 0.6rem; }

        /* browser mock: soften the device shadow, tighten tabs so more fit before the
           strip scrolls, and shrink the handwritten note to the narrower frame */
        .browser-frame { box-shadow: 0 12px 30px rgba(40, 44, 60, 0.18); max-width: 100%; }
        .tab-btn { padding: 6px 11px 7px; }
        .handwritten-note { width: 300px; height: 120px; }

        /* THE FIX: the tab strip is a flex child; without min-width:0 its 5 tabs force
           the whole browser frame wider than the phone (cut off on the right). Give it
           min-width:0 + flex-basis 0 so its overflow-x:auto engages and the tabs scroll
           WITHIN the frame instead of blowing the layout wide. */
        .browser-tab-strip { min-width: 0; }
        .tab-strip-tabs { flex: 1 1 0%; min-width: 0; }
      }
      /* Touch devices have no hover, so the nav enlarge — both the :hover growth and
         the persisted cross-page handoff (pre-tl/pre-tr) — only reads as a broken
         giant word. Keep the nav labels small and static on mobile. */
      @media (hover: none) {
        .grow, .grow:hover, html.pre-tl .grow, html.pre-tr .grow {
          font-size: 0.72rem !important;
          font-weight: 600 !important;
          letter-spacing: 0.16em !important;
        }
      }

    </style>

    <script>
      window.addEventListener('pointermove', () => {
        document.documentElement.classList.remove('pre-tl');
      }, { once: true });

      // ——— smooth exit: gentle opacity dip, then navigate (internal links only) ———
      const page = document.querySelector('.page');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a');
        if (!a) return;
        const href = a.getAttribute('href');
        if (!href || a.target === '_blank' || a.hasAttribute('download')) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;
        const url = new URL(href, location.href);
        if (url.origin !== location.origin || url.pathname === location.pathname) return;
        e.preventDefault();
        if (a.classList.contains('work')) sessionStorage.setItem('navTL', '1');
        if (a.classList.contains('info')) sessionStorage.setItem('navTR', '1');
        if (reduceMotion) { window.location.href = url.href; return; }
        page?.classList.add('leaving');
        setTimeout(() => { window.location.href = url.href; }, 200);
      });
      window.addEventListener('pageshow', (e) => { if (e.persisted) page?.classList.remove('leaving'); });

      // ——— reveal-on-scroll ———
      const reveals = document.querySelectorAll('.reveal');
      if (reduceMotion) {
        reveals.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
          });
        }, { threshold: 0.2, rootMargin: '0px 0px -12% 0px' });
        reveals.forEach((el) => io.observe(el));
      }

      // ——— browser mock: tabbed Vimeo demos, lazily booted, the active one plays only in view ———
      const vimeoScript = document.createElement('script');
      vimeoScript.src = 'https://player.vimeo.com/api/player.js';
      vimeoScript.onload = () => {
        const buttons = document.querySelectorAll('.tab-btn');
        const panels = document.querySelectorAll('.tab-panel');
        const urlDisplay = document.getElementById('url-display');
        const players: any[] = [];

        const getPlayer = (i: number) => {
          if (!players[i]) {
            const iframe = panels[i] && panels[i].querySelector('iframe');
            if (iframe) { players[i] = new (window as any).Vimeo.Player(iframe); players[i].setVolume(0); }
          }
          return players[i];
        };
        const activeIndex = () => [...panels].findIndex((p) => p.classList.contains('active'));

        let inView = false;
        const section = document.querySelector('.tab-panels');
        if (section) {
          new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              inView = entry.isIntersecting;
              const p = getPlayer(activeIndex());
              if (!p) return;
              if (inView) p.play().catch(() => {}); else p.pause().catch(() => {});
            });
          }, { threshold: 0.4 }).observe(section);
        }

        buttons.forEach((btn, i) => {
          btn.addEventListener('click', () => {
            const cur = getPlayer(activeIndex());
            if (cur) cur.pause().catch(() => {});
            buttons.forEach((b) => b.classList.remove('active'));
            panels.forEach((p) => p.classList.remove('active'));
            btn.classList.add('active');
            panels[i].classList.add('active');
            if (urlDisplay) urlDisplay.textContent = (btn as HTMLElement).dataset.url || '';
            const next = getPlayer(i);
            if (next && inView) next.play().catch(() => {});
          });
        });
      };
      document.head.appendChild(vimeoScript);
    </script>
  </body>
</html>
