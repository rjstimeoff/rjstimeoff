---
// Timeoff — Ish Knits. A brand container, not a single piece: the page is titled for
// the client (ongoing work), and each project lives in its own titled section so more
// can stack below over time. Light graphic-design page — artwork shown large on the
// painterly /work backdrop, shared corner chrome, no long write-up.
const works = [
  {
    title: 'Sip & Stitch Flyer',
    note: 'Flyer / advert design for Ish Knits’s Sip & Stitch Night. Aimed at getting young people to socialize at local bars and partake in “grandma hobbies.” I thought it would be fun to make some images in Midjourney that looked like a pretty young lady dressed up as an old lady at a bar. Once the images were together I brought them over to Figma for the actual design. I went with this bold and semi-playful font that fit the vibe well and could be reused for multiple use cases. The headline is great because it blends bold visuals with an intriguing tagline that invites curiosity. The QR code is right in that same sight line, so people’s next instinct will be to scan and learn more. And then there is the “sip & stitch” tagline below to offer a hint more context. I love how these turned out.',
    plates: [
      { src: '/ish-knits/sip-stitch-1.png', alt: 'Sip & Stitch flyer — “Grandma was right”, green beret' },
      { src: '/ish-knits/sip-stitch-2.png', alt: 'Sip & Stitch flyer — “Grandma was right”, seated portrait' },
      { src: '/ish-knits/sip-stitch-3.png', alt: 'Sip & Stitch flyer — “Grandma was right”, party candid' },
    ],
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ish Knits — Timeoff</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      if (window.matchMedia && window.matchMedia('(max-width: 768px)').matches) {
        document.documentElement.classList.add('is-mobile');
      }
    </script>
    <script is:inline>
      if (sessionStorage.getItem('navTL')) {
        document.documentElement.classList.add('pre-tl');
        sessionStorage.removeItem('navTL');
      }
    </script>
  </head>
  <body>
    <main class="proj">
      <header class="lead">
        <p class="kicker">Graphic Design · Client</p>
        <h1 class="title">Ish Knits</h1>
        <p class="note">Ongoing design work for Ish Knits — a knitwear studio and its events.</p>
      </header>

      {works.map((w) => (
        <section class="work">
          <header class="work-head">
            <h2 class="work-title">{w.title}</h2>
            {w.note && <p class="work-note">{w.note}</p>}
          </header>
          <div class="plates">
            {w.plates.map((p) => (
              <figure class="plate">
                <img src={p.src} alt={p.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        </section>
      ))}
    </main>

    <nav class="chrome" aria-label="site">
      <a class="label tl work grow" href="/work">Work</a>
      <a class="label tr info grow" href="/information">Information</a>
    </nav>

    <style>
      :root {
        --fg: #d6352a;
        --ink: #26241f;
        --muted: rgba(38, 36, 31, 0.5);
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: #eef0ec; scroll-behavior: smooth; }
      body {
        background: #eef0ec url('/work-bg.png') center / cover no-repeat fixed;
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      .proj {
        position: relative;
        z-index: 1;
        max-width: min(92vw, 1080px);
        margin: 0 auto;
        padding: 22vh 0 16vh;
        animation: page-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) backwards;
      }
      @keyframes page-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) { .proj { animation: none; } }

      .lead { max-width: 40ch; margin-bottom: 10vh; }
      .kicker { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg); margin-bottom: 1.2rem; }
      .title { font-size: clamp(2.6rem, 7vw, 5.4rem); font-weight: 400; line-height: 1; letter-spacing: -0.012em; color: var(--fg); }
      .note { font-size: clamp(1rem, 1.6vw, 1.15rem); line-height: 1.5; color: var(--muted); margin-top: 1.6rem; }

      /* ——— each piece is its own titled section; sections stack as more are added ——— */
      .work { border-top: 1px solid rgba(38, 36, 31, 0.14); padding-top: clamp(2rem, 4vh, 3.2rem); margin-top: clamp(3rem, 7vh, 6rem); }
      .work:first-of-type { margin-top: 0; }
      .work-head { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.1rem; margin-bottom: clamp(2rem, 4vh, 3.2rem); }
      .work-title { font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.01em; color: var(--ink); }
      .work-note { font-size: clamp(0.95rem, 1.4vw, 1.08rem); line-height: 1.6; color: var(--muted); max-width: 100%; }

      /* three flyer variations, side by side — a series */
      .plates {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: clamp(1rem, 2.4vw, 2.2rem);
      }
      .plate { line-height: 0; }
      .plate img {
        width: 100%;
        height: auto;
        display: block;
        box-shadow: 0 22px 60px rgba(40, 44, 60, 0.22);
      }

      /* ——— corner chrome (matches /work + project pages) ——— */
      .chrome { position: fixed; inset: 0; z-index: 2; pointer-events: none; mix-blend-mode: difference; }
      .label { position: fixed; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; }
      .grow {
        pointer-events: auto; text-decoration: none; white-space: nowrap; line-height: 1; will-change: font-size;
        transition: font-size 0.62s cubic-bezier(0.16, 1, 0.3, 1), letter-spacing 0.62s cubic-bezier(0.16, 1, 0.3, 1), font-weight 0.62s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .grow:hover { font-weight: 800; letter-spacing: -0.02em; }
      .work:hover { font-size: clamp(2.4rem, 6vw, 5.6rem); }
      .info:hover { font-size: clamp(1.8rem, 4vw, 3.9rem); }
      html.pre-tl .grow { transition: none; }
      html.pre-tl .work { font-size: clamp(2.4rem, 6vw, 5.6rem); font-weight: 800; letter-spacing: -0.02em; }
      .tl { top: 1.9rem; left: 2.2rem; }
      .tr { top: 1.9rem; right: 2.2rem; }

      @media (max-width: 768px) {
        .proj { padding: 6rem 1.4rem 4rem; max-width: none; }
        .lead { margin-bottom: 3.5rem; }
        .plates { grid-template-columns: 1fr; gap: 1.4rem; }
        .plate img { box-shadow: 0 12px 34px rgba(40, 44, 60, 0.2); }
        .chrome { position: absolute; }
        .label { position: absolute; font-size: 0.72rem; letter-spacing: 0.16em; }
        .tl { top: 1.6rem; left: 1.4rem; }
        .tr { top: 1.6rem; right: 1.4rem; }
      }
      @media (hover: none) {
        .grow, .grow:hover, html.pre-tl .grow {
          font-size: 0.72rem !important; font-weight: 600 !important; letter-spacing: 0.16em !important;
        }
      }
    </style>

    <script>
      // corner-nav persisted-enlarge handoff (see /work, /timeoff)
      document.querySelectorAll<HTMLAnchorElement>('.chrome a').forEach((a) => {
        a.addEventListener('click', () => {
          if (a.classList.contains('work')) sessionStorage.setItem('navTL', '1');
          if (a.classList.contains('info')) sessionStorage.setItem('navTR', '1');
        });
      });
      window.addEventListener('pointermove', () => {
        document.documentElement.classList.remove('pre-tl');
        document.documentElement.classList.remove('pre-tr');
      }, { once: true });
    </script>
  </body>
</html>
