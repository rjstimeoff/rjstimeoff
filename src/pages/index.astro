---
// Timeoff — home. Clean slate. Build up from here.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Timeoff</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Cross-page swipe direction. Axis: Work(0) · Home(1) · Information(2).
      (function () {
        // Directional swipe is a desktop mechanic. On mobile we let the browser's
        // default view-transition cross-fade play instead (smooth, no slide).
        var mobile = window.matchMedia('(max-width: 768px)').matches;
        function axis(p) {
          if (p === '/' || p === '') return 1;
          if (p.indexOf('/work') === 0) return 0;
          if (p.indexOf('/information') === 0) return 2;
          return null;
        }
        function dirType(fromUrl, toUrl) {
          var f = axis(new URL(fromUrl).pathname), t = axis(new URL(toUrl).pathname);
          if (f == null || t == null || f === t) return null;
          return t > f ? 'to-right' : 'to-left';
        }
        window.addEventListener('pageswap', function (e) {
          if (mobile) { sessionStorage.removeItem('swipeDir'); return; }
          if (!e.viewTransition || !e.activation || !e.activation.from) { sessionStorage.removeItem('swipeDir'); return; }
          var type = dirType(e.activation.from.url, e.activation.entry.url);
          if (!type) { sessionStorage.removeItem('swipeDir'); return; }
          sessionStorage.setItem('swipeDir', type);
          e.viewTransition.types.add(type);
        });
        window.addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return;
          if (mobile) { sessionStorage.removeItem('swipeDir'); return; }
          var type = sessionStorage.getItem('swipeDir');
          sessionStorage.removeItem('swipeDir');
          if (!type) {
            var a = window.navigation && navigation.activation;
            if (a && a.from) type = dirType(a.from.url, a.entry.url);
          }
          if (type) e.viewTransition.types.add(type);
        });
      })();
    </script>
    <style>
      :root {
        --ground: #ffffff;
        --ink: #101113;
        --font: "Host Grotesk", system-ui, -apple-system, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--font);
        -webkit-font-smoothing: antialiased;
        overflow: hidden;               /* home is a single screen — no scroll */
      }

      .nav-link {
        position: fixed;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        z-index: 2;
      }
      .brand {
        top: 1.1rem;
        left: 50%;
        transform: translateX(-50%);
      }

      /* mobile-only plain corner nav — replaces the scatter blobs on touch.
         Same grammar as /work and /information (top corners, 0.95rem). */
      .corner-m {
        position: fixed;
        top: 1.1rem;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        z-index: 2;
        display: none;
        transition: color 0.45s ease;
      }
      .corner-m.left { left: 1.5rem; }
      .corner-m.right { right: 1.5rem; }
      body.art .corner-m { color: #fff; text-shadow: 0 1px 16px rgba(0,0,0,0.5); }

      /* scattered, gently drifting letter clusters */
      .scatter {
        position: fixed;
        top: 50%;
        width: 175px;
        height: 150px;
        margin-top: -75px;          /* vertical center */
        z-index: 2;
        cursor: pointer;
      }
      .scatter.left  { left: 1rem; }
      .scatter.right { right: 1rem; }
      .scatter, .scatter:visited { color: var(--ink); text-decoration: none; }

      /* outer layer: holds position — scattered by default, assembled on hover */
      .scatter .pos {
        position: absolute;
        left: 0;
        top: 0;
        transform: translate(var(--bx), var(--by));
        transition: transform 520ms cubic-bezier(0.4, 0, 0.2, 1);
        will-change: transform;
      }
      .scatter:hover .pos,
      .scatter:focus-visible .pos {
        transform: translate(var(--ax), var(--ay));
      }

      /* inner layer: the glyph (static — no drift) */
      .scatter .gl {
        display: inline-block;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--ink);
      }

      .hero {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding: 6rem 1.5rem;
        text-align: left;
        position: relative;
        z-index: 1;
      }
      .hero-text {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: min(880px, 88vw);
      }
      .hero p {
        margin: 0;
        font-size: clamp(1.05rem, 1.5vw, 1.25rem);
        font-weight: 400;
        line-height: 1.35;
        letter-spacing: -0.01em;
      }
      .hero .cta {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.15em;
        cursor: pointer;
        white-space: nowrap;
      }
      .cta-arrow {
        display: inline-block;
        width: 0.62em;
        height: 0.62em;
        margin-left: 0.18em;
        vertical-align: 0.28em;
        opacity: 0.5;
      }

      /* ——— identity art piece: a soft, slow bleed that grows from the click ———
         Painting = a true-scale cover <image>, revealed through a growing SVG mask
         whose alpha is displaced into an organic wet front. Image and mask are separate
         layers, so the front reaches organically with no zoom or distortion. */
      .artpiece {
        position: fixed;
        inset: 0;
        z-index: 0;
        display: block;
        pointer-events: none;
        overflow: visible;              /* let the oversized image extend offscreen */
        filter: url(#bleed-rough);      /* organic edge as an element filter (WebKit-safe) */
      }
      /* Radial-expand bleed — used on touch (mobile) AND in WebKit/Safari, where
         the organic SVG bloom can't animate. A full-cover image div (.art-radial)
         is clipped to a circle that grows from the tap (--cx/--cy) — clip-path
         radius animates reliably on an HTML element. Its wrapper (.art-stage)
         carries the edge-roughening filter, applied ABOVE the clipped layer so it
         wiggles the already-clipped boundary into an organic edge without warping
         the interior. Hidden by default; Chrome desktop uses the organic .artpiece. */
      .art-stage {
        display: none;
        position: fixed; inset: 0; z-index: 0;
        pointer-events: none;
      }
      .art-radial {
        position: absolute; inset: 0;
        background: url(/identity-room.jpg) center / cover no-repeat;
        clip-path: circle(0px at var(--cx, 50%) var(--cy, 50%));
        transition: clip-path 1.15s cubic-bezier(0.22, 1, 0.3, 1);
      }
      /* final radius pushes the boundary (and its wiggle) offscreen → full cover */
      body.art .art-radial { clip-path: circle(200% at var(--cx, 50%) var(--cy, 50%)); }
      body.art .art-stage { pointer-events: auto; cursor: pointer; }
      html.art-instant .art-radial { transition: none; }

      /* The reveal circle grows from the click point (--cx/--cy). Its radius is
         driven frame-by-frame in JS (see the art script) rather than by a CSS `r`
         transition — WebKit/Safari refuses to animate CSS `r`, but honors the `r`
         attribute set per frame. Same circle, same displacement filter, so the
         organic bleed is byte-for-byte identical in Chrome and Safari. */
      .disc {
        cx: var(--cx, 50%);
        cy: var(--cy, 50%);
      }
      body.art .artpiece { pointer-events: auto; cursor: pointer; }

      /* text stays legible over the art: white, a touch heavier, soft shadow */
      .hero p, .hero .cta, .nav-link, .scatter .gl {
        transition: color 0.45s ease;
      }
      body.art .hero p { color: #fff; font-weight: 600; text-shadow: 0 1px 22px rgba(0,0,0,0.45); }
      body.art .hero .cta { color: #fff; }
      body.art .nav-link,
      body.art .scatter .gl { color: #fff; text-shadow: 0 1px 16px rgba(0,0,0,0.5); }

      .bleed-defs { position: absolute; pointer-events: none; }

      @media (prefers-reduced-motion: reduce) {
        /* No organic reveal — drop the mask and simply cross-fade the whole painting. */
        .art-img { mask: none; -webkit-mask: none; }
        .artpiece { opacity: 0; transition: opacity 0.4s ease; }
        body.art .artpiece { opacity: 1; }
      }
      /* ——— mobile: swap the hover-scatter blobs for plain corner nav ——— */
      @media (max-width: 768px) {
        .scatter { display: none; }
        .corner-m { display: block; }

        /* smaller, centered statement — a single centered column, lines centered */
        .hero { padding: 6rem 1.5rem; text-align: center; }
        .hero-text { max-width: 32rem; gap: 1.1rem; align-items: center; }
        .hero p { font-size: 0.95rem; line-height: 1.45; }
        .cta-arrow { vertical-align: 0.2em; }

        /* Mobile: use the clean radial-expand layer (styled above, no edge filter)
           instead of the organic SVG bloom. */
        .artpiece { display: none; }
        .art-stage { display: block; }
      }

      /* ——— cross-page swipe (native view transitions) ——— */
      @view-transition { navigation: auto; }
      ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
      @keyframes swipe-out-left  { to   { transform: translateX(-100%); } }
      @keyframes swipe-in-right  { from { transform: translateX(100%);  } }
      @keyframes swipe-out-right { to   { transform: translateX(100%);  } }
      @keyframes swipe-in-left   { from { transform: translateX(-100%); } }
      :root:active-view-transition-type(to-right)::view-transition-old(root) { animation: swipe-out-left 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; }
      :root:active-view-transition-type(to-right)::view-transition-new(root) { animation: swipe-in-right 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; box-shadow: -1px 0 0 rgba(0, 0, 0, 0.14); }
      :root:active-view-transition-type(to-left)::view-transition-old(root)  { animation: swipe-out-right 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; }
      :root:active-view-transition-type(to-left)::view-transition-new(root)  { animation: swipe-in-left 0.55s cubic-bezier(0.7, 0, 0.2, 1) both; box-shadow: 1px 0 0 rgba(0, 0, 0, 0.14); }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root), ::view-transition-new(root) { animation: none !important; }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      // Persist the hero art-piece "open" state across navigations (per session).
      // Runs before paint: if it was left open, mark the doc so the image restores
      // instantly (the .art-instant class suppresses the grow animation).
      if (sessionStorage.getItem('artOpen') === '1') {
        document.documentElement.classList.add('art-instant');
        document.body.classList.add('art');
      }
    </script>
    {/* Identity art piece. A growing circular <mask> reveals the painting; the organic
        wet edge is added by a displacement filter on the WHOLE .artpiece (CSS filter),
        NOT inside the mask — WebKit/Safari renders a filtered mask as blank, but renders
        an element-level displacement fine. The filter displaces the alpha silhouette and
        composites the original image back through it, so the interior never warps. The
        <image> is oversized (−30%…130%) with overflow visible so the displaced boundary
        stays offscreen at full open (full coverage, no ragged screen edges). */}
    <svg class="artpiece" width="100%" height="100%" preserveAspectRatio="none" aria-hidden="true"
      xmlns:xlink="http://www.w3.org/1999/xlink">
      <defs>
        {/* Broad lobes (scale 180) = reaching tendrils; fine grain (scale 22) = fibre.
            Operates on SourceAlpha, then composites the crisp SourceGraphic through it. */}
        <filter id="bleed-rough" x="-45%" y="-45%" width="190%" height="190%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.006" numOctaves="2" seed="4" result="lobes" />
          <feDisplacementMap in="SourceAlpha" in2="lobes" scale="180" xChannelSelector="R" yChannelSelector="G" result="reach" />
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="9" result="fibre" />
          <feDisplacementMap in="reach" in2="fibre" scale="22" xChannelSelector="R" yChannelSelector="G" result="rough" />
          <feComposite in="SourceGraphic" in2="rough" operator="in" />
        </filter>
        {/* Soft-edged disc (feather + damp halo) — objectBoundingBox so it scales with r. */}
        <radialGradient id="disc-grad">
          <stop offset="55%" stop-color="#fff" stop-opacity="1" />
          <stop offset="80%" stop-color="#fff" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#fff" stop-opacity="0" />
        </radialGradient>
        <mask id="bleed-mask" maskUnits="userSpaceOnUse" x="-40%" y="-40%" width="180%" height="180%">
          <circle class="disc" cx="50%" cy="50%" r="0" fill="url(#disc-grad)" />
        </mask>
      </defs>
      <image class="art-img" href="/identity-room.jpg" xlink:href="/identity-room.jpg"
        x="-30%" y="-30%" width="160%" height="160%" preserveAspectRatio="xMidYMid slice" mask="url(#bleed-mask)" />
    </svg>
    {/* Mobile-only plain radial-expand bleed (clean circle, no edge filter).
        Desktop (Chrome + Safari) uses the organic .artpiece above. */}
    <div class="art-stage" aria-hidden="true"><div class="art-radial"></div></div>

    <a class="nav-link brand" href="/">timeoff</a>
    <a class="scatter left" href="/work" aria-label="Work"
      ><span>W</span><span>o</span><span>r</span><span>k</span></a>
    <a class="scatter right" href="/information" aria-label="Information"
      ><span>I</span><span>n</span><span>f</span><span>o</span><span>r</span><span>m</span><span>a</span><span>t</span><span>i</span><span>o</span><span>n</span></a>
    <a class="corner-m left" href="/work">Work</a>
    <a class="corner-m right" href="/information">Information</a>

    <main class="hero">
      <div class="hero-text">
        <p>Timeoff helps companies stand out through experimental design.</p>
        <p>We work with ambitious companies that care about how they show up.</p>
        <p>Putting people first and <a class="cta" href="#">challenging the expected.<svg class="cta-arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
      </div>
    </main>

    <script is:inline>
      // Scattered letter clusters that gather into the word on hover.
      // Each cluster RE-scatters to a fresh arrangement when the pointer leaves,
      // so it feels novel without ever being sporadic (same tight, safe ranges).
      (function () {
        var BOX_W = 175, BOX_H = 150;
        var advance = 14;   // horizontal step per letter — keeps reading order
        var midY = 75;      // vertical center
        var minGapX = 16, minGapY = 22;   // clearance to count letters as "clear"

        // one-time: wrap each letter as .pos (position) > .gl (drift), measure widths
        function build(el) {
          var items = [];
          Array.prototype.forEach.call(el.querySelectorAll('span'), function (s) {
            var ch = s.textContent;
            s.textContent = '';
            s.className = 'pos';
            var gl = document.createElement('span');
            gl.className = 'gl';
            gl.textContent = ch;
            // copy Astro's scope attribute so the scoped .gl CSS rules apply
            // (JS-created elements don't get it automatically)
            Array.prototype.forEach.call(s.attributes, function (a) {
              if (a.name.indexOf('data-astro-cid') === 0) gl.setAttribute(a.name, '');
            });
            s.appendChild(gl);
            items.push({ pos: s, gl: gl, w: gl.offsetWidth });
          });
          return items;
        }

        // (re)assign scattered base positions + drift. Positions only —
        // the assembled word target is locked separately so it never moves.
        // rnd() -> 0..1; pass a fresh source each time for a new arrangement.
        function scatter(items, rnd) {
          var cursor = 6;
          var placed = [];
          items.forEach(function (it) {
            var bx = cursor + (rnd() * 2 - 1) * 3;   // small x jitter around the step
            cursor += advance;
            var by, best = 0, bestGap = -1;          // pick a clear vertical spot
            for (var t = 0; t < 40; t++) {
              var cand = midY + (rnd() * 2 - 1) * 40;
              var worst = 999;
              for (var i = 0; i < placed.length; i++) {
                if (Math.abs(placed[i].x - bx) < minGapX)
                  worst = Math.min(worst, Math.abs(placed[i].y - cand));
              }
              if (worst >= minGapY) { by = cand; break; }
              if (worst > bestGap) { bestGap = worst; best = cand; }
            }
            if (by === undefined) by = best;
            placed.push({ x: bx, y: by });

          });

          // recenter the cluster's vertical centre of mass to the box middle,
          // so both blobs sit at the same height (and assembled words are level)
          var meanY0 = placed.reduce(function (a, p) { return a + p.y; }, 0) / placed.length;
          var shift = midY - meanY0;
          items.forEach(function (it, i) {
            placed[i].y += shift;
            it.pos.style.setProperty('--bx', placed[i].x.toFixed(1) + 'px');
            it.pos.style.setProperty('--by', placed[i].y.toFixed(1) + 'px');
          });
          return placed;
        }

        // lock the assembled word position ONCE — same settle spot every hover
        function lockAssembled(items, placed) {
          var total = items.reduce(function (a, it) { return a + it.w; }, 0);
          var meanX = placed.reduce(function (a, p) { return a + p.x; }, 0) / placed.length;
          var meanY = placed.reduce(function (a, p) { return a + p.y; }, 0) / placed.length;
          var ax = meanX - total / 2;
          var ay = Math.min(Math.max(meanY, 12), BOX_H - 24);
          items.forEach(function (it) {
            it.pos.style.setProperty('--ax', ax.toFixed(1) + 'px');
            it.pos.style.setProperty('--ay', ay.toFixed(1) + 'px');
            ax += it.w;
          });
        }

        // seeded PRNG for the initial arrangement (stable first paint)
        function mulberry32(seed) {
          return function () {
            seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
            var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
          };
        }

        function init(el, seed) {
          if (!el) return;
          var items = build(el);
          var placed = scatter(items, mulberry32(seed));  // stable first arrangement
          lockAssembled(items, placed);                   // fixed settle spot, set once
          // re-scatter on leave: gather -> drift out to a fresh (random) spread
          el.addEventListener('mouseleave', function () {
            scatter(items, Math.random);                  // positions vary; word target does not
          });
        }

        // Scatter is a pointer/hover mechanic — skip it on mobile, where the
        // blobs are hidden and plain corner links stand in.
        if (!window.matchMedia('(max-width: 768px)').matches) {
          init(document.querySelector('.scatter.left'), 1017);
          init(document.querySelector('.scatter.right'), 2620);
        }
      })();

      // Identity art piece: clicking "challenging the expected." bleeds the image
      // out from the click point to fill the screen; text turns white. Click the
      // link again, click the art, or press Esc to reverse.
      (function () {
        var cta = document.querySelector('.cta');
        var art = document.querySelector('.artpiece');     // desktop SVG bloom
        var radial = document.querySelector('.art-stage'); // mobile plain radial
        if (!cta || !art) return;
        // Origin on <html> so both the disc (cx:var(--cx)) and the mobile clip
        // (clip-path ... at var(--cx)) read the same tap point by inheritance.
        var root = document.documentElement;

        // Drive the disc radius frame-by-frame (setAttribute) rather than via a CSS
        // `r` transition — WebKit won't animate the latter. Same circle + filter, so
        // the organic bleed animates identically in Chrome and Safari.
        var disc = art.querySelector('.disc');
        var OPEN_R = 6000, DUR = 1700, rafId = null;
        var ease = (function (x1, y1, x2, y2) {   // cubic-bezier(0.22,1,0.3,1)
          function A(a, b) { return 1 - 3 * b + 3 * a; }
          function B(a, b) { return 3 * b - 6 * a; }
          function C(a) { return 3 * a; }
          function calc(t, a, b) { return ((A(a, b) * t + B(a, b)) * t + C(a)) * t; }
          function slope(t, a, b) { return 3 * A(a, b) * t * t + 2 * B(a, b) * t + C(a); }
          return function (x) {
            if (x <= 0) return 0; if (x >= 1) return 1;
            var t = x;
            for (var i = 0; i < 6; i++) { var s = slope(t, x1, x2); if (!s) break; t -= (calc(t, x1, x2) - x) / s; }
            return calc(t, y1, y2);
          };
        })(0.22, 1, 0.3, 1);
        function curR() { return parseFloat(disc.getAttribute('r')) || 0; }
        function setR(v) { if (rafId) { cancelAnimationFrame(rafId); rafId = null; } disc.setAttribute('r', v); }
        function animateR(to) {
          if (rafId) cancelAnimationFrame(rafId);
          var from = curR(), start = null;
          function frame(now) {
            if (start === null) start = now;
            var t = Math.min(1, (now - start) / DUR);
            disc.setAttribute('r', from + (to - from) * ease(t));
            rafId = t < 1 ? requestAnimationFrame(frame) : null;
          }
          rafId = requestAnimationFrame(frame);
        }

        // Restore a persisted "open" state (flagged pre-paint by .art-instant): re-apply the
        // stored origin so a later close collapses to the right point, then re-enable the grow
        // transition on the next frame so closing still animates.
        if (root.classList.contains('art-instant')) {
          var sx = sessionStorage.getItem('artCx'), sy = sessionStorage.getItem('artCy');
          if (sx) root.style.setProperty('--cx', sx);
          if (sy) root.style.setProperty('--cy', sy);
          setR(OPEN_R);   // restore fully-open instantly (no grow)
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { root.classList.remove('art-instant'); });
          });
        }

        function setOrigin(x, y) {
          // px origin in viewport space — where the bleed grows from
          root.style.setProperty('--cx', Math.round(x) + 'px');
          root.style.setProperty('--cy', Math.round(y) + 'px');
        }
        function open(e) {
          var r = cta.getBoundingClientRect();
          setOrigin(e && e.clientX ? e.clientX : r.left + r.width / 2,
                    e && e.clientY ? e.clientY : r.top + r.height / 2);
          document.body.classList.add('art');
          animateR(OPEN_R);
          sessionStorage.setItem('artOpen', '1');
          sessionStorage.setItem('artCx', root.style.getPropertyValue('--cx'));
          sessionStorage.setItem('artCy', root.style.getPropertyValue('--cy'));
        }
        function close() {
          document.body.classList.remove('art');
          animateR(0);
          sessionStorage.removeItem('artOpen');
        }

        cta.addEventListener('click', function (e) {
          e.preventDefault();
          if (document.body.classList.contains('art')) close(); else open(e);
        });
        art.addEventListener('click', close);
        if (radial) radial.addEventListener('click', close);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
      })();
    </script>
  </body>
</html>
