---
// Timeoff — UI Playground project page. SCAFFOLD (same system as Cosign).
// 3 demos: core workflow, saving to gallery, Midjourney art.
// Media are placeholders. Copy = RJ's voice, condensed from the write-up.
const meta = 'Tool Design · Front End · Interaction · 2026';
const sub = 'A UI Sandbox & Recorder — Personal Tool';

const beats = [
  [
    "UI Playground is a sandbox I built for prototyping UI elements in isolation, recording clean demos, and exporting the code for each one. Other tools do these things — a UI sandbox, a demo recorder — I just didn't feel like paying for them…",
    "It's wired to Claude Code: prompt and build your elements there, and UI Playground is your live view. Save elements to a library and export the code for another project. My favorite part is the focus/record mode — pick a background, add a watermark, and you've got a clean environment to record your elements in action. Pretty sweet.",
  ],
  [
    "Saving a new element to the gallery — build it, save it, and export the code whenever you want to drop it into another project.",
  ],
  [
    "The logo, backgrounds, and inspo art — all whipped up in Midjourney.",
  ],
];
// Media per beat: core workflow, saving to gallery (Vimeo), Midjourney art (image grid)
const media = [
  { type: 'vimeo', id: '1183218786' },
  { type: 'vimeo', id: '1183218806' },
  { type: 'grid', srcs: ['/playground_logo.png', '/playground_pnw_bg.jpg', '/playground_waves_bg.jpg', '/playground_art.jpg'] },
];
const nextProject = { title: 'Cosign', href: '/cosign' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UI Playground — Timeoff</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --ground: #ffffff; --ink: #101113; --ink-soft: #6f6f68; --ink-faint: #a5a49c;
        --placeholder: #ECEBE7; --font: "Host Grotesk", system-ui, -apple-system, sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ground); color: var(--ink); font-family: var(--font); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }

      .brand {
        position: fixed; top: 1.1rem; left: 50%; transform: translateX(-50%) translateY(0);
        font-size: 0.95rem; font-weight: 500; letter-spacing: 0.01em; color: var(--ink);
        text-decoration: none; z-index: 3;
        transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s ease;
      }
      .brand.tucked { transform: translateX(-50%) translateY(-160%); opacity: 0; pointer-events: none; }
      .back { position: fixed; top: 1.1rem; left: 1.25rem; font-size: 0.95rem; font-weight: 500; color: var(--ink); text-decoration: none; z-index: 3; }
      .back { transition: opacity 0.2s ease; }
      .back:hover { opacity: 0.55; }

      .beats { display: grid; grid-template-columns: 3fr 5fr; column-gap: 2.75rem; row-gap: 6rem; align-items: start; padding: 5.5rem 1.5rem 6rem; max-width: 1600px; margin: 0 auto; }
      .fn { font-size: 0.72rem; font-weight: 500; letter-spacing: 0.08em; color: var(--ink-faint); font-variant-numeric: tabular-nums; margin-bottom: 0.7rem; }
      .beat-text { max-width: 36ch; }
      .proj-title { font-size: 2rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.3rem; }
      .proj-sub { font-size: 0.98rem; color: var(--ink); margin: 0 0 0.4rem; }
      .proj-meta { font-size: 0.82rem; color: var(--ink-soft); margin: 0 0 1.4rem; }
      .beat-text p { margin: 0; font-size: 0.98rem; line-height: 1.6; }
      .beat-text p + p { margin-top: 1.1rem; }
      .media { aspect-ratio: 16 / 9; background: var(--placeholder); border-radius: 2px; width: 100%; overflow: hidden; position: relative; }
      .demo-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
      .media-grid { column-count: 2; column-gap: 0.75rem; }
      .media-grid img { width: 100%; height: auto; display: block; border-radius: 2px; margin-bottom: 0.75rem; break-inside: avoid; }

      .next { grid-column: 1 / -1; display: inline-flex; flex-direction: column; gap: 0.3rem; margin-top: 3rem; text-decoration: none; color: inherit; width: max-content; }
      .next-kicker { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--ink-faint); }
      .next-title { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
      .next:hover .next-title { transform: translateX(0.4rem); }

      .beat-text, .beat-media, .next {
        opacity: 0; transform: translateY(14px);
        animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; animation-delay: calc(var(--i) * 90ms);
      }
      @keyframes rise { to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) {
        .beat-text, .beat-media, .next { opacity: 1; transform: none; animation: none; }
        .brand { transition: opacity 0.3s ease; }
        .brand.tucked { transform: translateX(-50%) translateY(0); }
      }
      @media (max-width: 900px) { .beats { grid-template-columns: 1fr; row-gap: 2.5rem; } .beat-text { max-width: none; } .beat-media .fn { display: none; } }
      @media (max-width: 768px) { .beats { padding: 5rem 1.2rem 4rem; column-gap: 1.4rem; } }
    </style>
  </head>
  <body>
    <a class="back" href="/work">Work</a>
    <a class="brand" href="/">timeoff</a>

    <main class="beats">
      {beats.map((paras, i) => (
        <>
          <div class="beat-text" style={`--i:${i}`}>
            <div class="fn">{String(i + 1).padStart(2, '0')}</div>
            {i === 0 && <h1 class="proj-title">UI Playground</h1>}
            {i === 0 && <p class="proj-sub">{sub}</p>}
            {i === 0 && <p class="proj-meta">{meta}</p>}
            {paras.map((para) => <p>{para}</p>)}
          </div>
          <div class="beat-media" style={`--i:${i}`}>
            <div class="fn">{String(i + 1).padStart(2, '0')}</div>
            {media[i].type === 'vimeo' && (
              <div class="media">
                <iframe class="demo-frame" data-src={`https://player.vimeo.com/video/${media[i].id}?background=1&muted=1&loop=1&autoplay=1`} loading="lazy" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" title=""></iframe>
              </div>
            )}
            {media[i].type === 'grid' && (
              <div class="media-grid">
                {media[i].srcs.map((s) => <img src={s} alt="" loading="lazy" />)}
              </div>
            )}
          </div>
        </>
      ))}

      <a class="next" href={nextProject.href}>
        <span class="next-kicker">Next</span>
        <span class="next-title">{nextProject.title}</span>
      </a>
    </main>

    <script is:inline>
      (function () {
        var brand = document.querySelector('.brand');
        if (!brand) return;
        var THRESHOLD = 6, ticking = false;
        function update() { brand.classList.toggle('tucked', window.scrollY > THRESHOLD); ticking = false; }
        window.addEventListener('scroll', function () { if (!ticking) { window.requestAnimationFrame(update); ticking = true; } }, { passive: true });
        update();
      })();

      // lazy-load Vimeo demos as they approach the viewport (background autoplay)
      (function () {
        var frames = Array.prototype.slice.call(document.querySelectorAll('.demo-frame'));
        if (!frames.length) return;
        function load(f) { if (!f.src) f.src = f.getAttribute('data-src'); }
        if (!('IntersectionObserver' in window)) { frames.forEach(load); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) { load(en.target); io.unobserve(en.target); } });
        }, { rootMargin: '300px 0px' });
        frames.forEach(function (f) { io.observe(f); });
      })();
    </script>
  </body>
</html>
