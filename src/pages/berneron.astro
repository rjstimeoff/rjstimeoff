---
import Seo from '../components/Seo.astro';
// Timeoff — Berneron project page. SCAFFOLD (graphic-design variant of the system).
// Same 3fr/5fr split, but the right column is an image grid that adapts to aspect
// ratio (wide = full width, portrait = 2-up), and the left holds one write-up.
// Real images. Copy = RJ's voice (verbatim write-up).
const meta = 'Graphic Design · Concept';
const works = [
  {
    title: 'Mirage Miroir — Editorial Spread',
    note: [
      "I wanted to do an editorial-style project based off one of my personal hobbies. I saw that one of my favorite watch brands, Berneron, was releasing a new version of their Mirage watch — the Mirage Miroir. Perfect subject. The idea was a full editorial spread for the launch, and the main visual concept I played with was “deception of the eyes” — obviously, because of the Mirage name.",
      "On the left I tried to make the background look as if you'd been staring at a screen too long — those blue-ish hues that come out from visual fatigue. A weird concept I came up with randomly, but I emulated it with subtle blue diffusions, a glass-like rectangle for framing, and the 3/4 watch shot with a slight blur. The right side started with the “MIRAGE” text heavily blurred in the background — barely visible unless you squint or look from afar — then the caseback shots falling down, and the rest is pure typography. Finally the Berneron logo across both pages. Super happy with the result.",
    ],
    plates: [
      { src: '/berneron/berneron-spread.png', alt: 'Berneron Mirage Miroir — editorial spread', span: 6 },
      { src: '/berneron/berneron-06.png', alt: 'Berneron Mirage Miroir — caseback shot', span: 3 },
      { src: '/berneron/berneron-07.png', alt: 'Berneron Mirage Miroir — caseback shot', span: 3 },
    ],
  },
];
const nextProject = { title: 'Ish Knits', href: '/ish-knits' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Berneron — Timeoff</title>
    <Seo title="Berneron — Timeoff" type="article" description="Berneron — a graphic design concept from Timeoff." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --ground: #ffffff; --ink: #101113; --ink-soft: #6f6f68; --ink-faint: #a5a49c;
        --placeholder: #ECEBE7; --line: #e6e5e0; --font: "Host Grotesk", system-ui, -apple-system, sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ground); color: var(--ink); font-family: var(--font); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }

      .brand {
        position: fixed; top: 1.1rem; left: 50%; transform: translateX(-50%) translateY(0);
        font-size: 0.95rem; font-weight: 500; letter-spacing: 0.01em; color: var(--ink);
        text-decoration: none; z-index: 3;
        transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s ease;
      }
      .brand.tucked { transform: translateX(-50%) translateY(-160%); opacity: 0; pointer-events: none; }
      .back { position: fixed; top: 1.1rem; left: 1.25rem; font-size: 0.95rem; font-weight: 500; color: var(--ink); text-decoration: none; z-index: 3; }
      .back { transition: opacity 0.2s ease; }
      .back:hover { opacity: 0.55; }

      .works { display: grid; grid-template-columns: 3fr 5fr; column-gap: 2.5rem; row-gap: 6rem; align-items: start; padding: 5.5rem 1.5rem 6rem; max-width: 1600px; margin: 0 auto; }
      .work-text { max-width: 38ch; }
      .proj-title { font-size: 2rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.3rem; }
      .proj-meta { font-size: 0.82rem; color: var(--ink-soft); margin: 0 0 1.8rem; }
      .work-title {
        font-size: 0.72rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--ink-soft); margin: 0 0 1rem; padding-top: 1.6rem; border-top: 1px solid var(--line);
      }
      .work-text p { margin: 0; font-size: 0.98rem; line-height: 1.6; }
      .work-text p + p { margin-top: 1.1rem; }

      .plates { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; }
      .plate { grid-column: span var(--span, 6); }
      .plate img { width: 100%; height: auto; display: block; border-radius: 2px; }

      .next { grid-column: 1 / -1; display: inline-flex; flex-direction: column; gap: 0.3rem; margin-top: 3rem; text-decoration: none; color: inherit; width: max-content; }
      .next-kicker { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--ink-faint); }
      .next-title { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
      .next:hover .next-title { transform: translateX(0.4rem); }

      .work-text, .plates, .next {
        opacity: 0; transform: translateY(14px);
        animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; animation-delay: calc(var(--i) * 90ms);
      }
      @keyframes rise { to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) {
        .work-text, .plates, .next { opacity: 1; transform: none; animation: none; }
        .brand { transition: opacity 0.3s ease; }
        .brand.tucked { transform: translateX(-50%) translateY(0); }
      }
      @media (max-width: 900px) { .works { grid-template-columns: 1fr; row-gap: 2.5rem; } .work-text { max-width: none; } }
    </style>
  </head>
  <body>
    <a class="back" href="/work">Work</a>
    <a class="brand" href="/">timeoff</a>

    <main class="works">
      {works.map((w, i) => (
        <>
          <div class="work-text" style={`--i:${i}`}>
            {i === 0 && <h1 class="proj-title">Berneron</h1>}
            {i === 0 && <p class="proj-meta">{meta}</p>}
            <h2 class="work-title">{w.title}</h2>
            {w.note.map((para) => <p>{para}</p>)}
          </div>
          <div class="plates" style={`--i:${i}`}>
            {w.plates.map((p) => (
              <figure class="plate" style={`--span:${p.span}`}>
                <img src={p.src} alt={p.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        </>
      ))}

      <a class="next" href={nextProject.href}>
        <span class="next-kicker">Next</span>
        <span class="next-title">{nextProject.title}</span>
      </a>
    </main>

    <script is:inline>
      (function () {
        var brand = document.querySelector('.brand');
        if (!brand) return;
        var THRESHOLD = 6, ticking = false;
        function update() { brand.classList.toggle('tucked', window.scrollY > THRESHOLD); ticking = false; }
        window.addEventListener('scroll', function () { if (!ticking) { window.requestAnimationFrame(update); ticking = true; } }, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
